{
  "name": "voiceact-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --preload ./src/instrument.ts --watch src/server.ts",
    "start": "bun --preload ./src/instrument.ts src/server.ts",
    "build": "bun tsc",
    "seed": "bun run src/seed.ts",
    "test": "bun test src/tests --timeout 30000",
    "test:watch": "bun test src/tests --watch",
    "test:coverage": "bun test src/tests --coverage"
  },
  "dependencies": {
    "@sentry/node": "^10.68.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "geoip-lite": "^2.0.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^9.0.3",
    "posthog-node": "^5.46.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "bun-types": "latest",
    "supertest": "^6.3.4",
    "typescript": "^5.8.3"
  }
}

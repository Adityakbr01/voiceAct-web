# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/voiceact

# =========================================
# 🔐 ADMIN CREDENTIALS (after running seed)
# =========================================
# Email: admin@voiceact.com
# Password: admin123
# Access: http://localhost:3000/admin/login
# =========================================

# JWT Authentication
JWT_SECRET=change-this-to-a-real-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# CORS & Cookies
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# SMTP Email (optional — for contact form notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@voiceact.in
ADMIN_NOTIFY_EMAIL=admin@voiceact.in

# File Uploads (future use)
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5

# PostHog Analytics (server-side events)
POSTHOG_KEY=

# Sentry Error Tracking
SENTRY_DSN=

# Rate Limiting (requests per 15 minutes per IP)
RATE_LIMIT_GENERAL=60
RATE_LIMIT_CONTACT=10
RATE_LIMIT_AUTH=5

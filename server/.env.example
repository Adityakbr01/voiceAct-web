# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas / External Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/voiceact?retryWrites=true&w=majority

# =========================================
# 🔐 ADMIN CREDENTIALS (after running seed)
# =========================================
# Email: admin@voiceact.tech
# Password: admin123
# Access: http://localhost:3000/admin/login
# =========================================

# JWT Authentication
JWT_SECRET=change-this-to-a-real-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# CORS & Cookies
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@voiceact.tech
EMAIL_REPLY_TO=support@voiceact.tech
EMAIL_SUPPORT=support@voiceact.tech
EMAIL_CONTACT=hello@voiceact.tech

# File Uploads (future use)
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5

# PostHog Analytics (server-side events)
POSTHOG_KEY=

# Sentry Error Tracking
SENTRY_DSN=

# Rate Limiting (requests per 15 minutes per IP)
RATE_LIMIT_GENERAL=60
RATE_LIMIT_CONTACT=10
RATE_LIMIT_AUTH=5

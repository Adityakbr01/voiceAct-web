# API Backend URL
# In development, the Next.js dev server proxies to localhost:5000
# In production, set this to your deployed API server URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Site Configuration (optional)
# NEXT_PUBLIC_SITE_URL=https://voiceact.in

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=


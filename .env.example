# =========================================
# VoiceAct Docker Compose Environment
# Copy this file to .env and fill in values
# =========================================

# ---------- Database (MongoDB Atlas / External Cluster) ----------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/voiceact?retryWrites=true&w=majority

# ---------- JWT ----------
JWT_SECRET=change-this-to-a-real-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# ---------- CORS & Cookies ----------
# In production behind Nginx, set to your domain
CORS_ORIGINS=http://localhost
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------- Resend Email Configuration ----------
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@voiceact.tech
EMAIL_REPLY_TO=support@voiceact.tech
EMAIL_SUPPORT=support@voiceact.tech
EMAIL_CONTACT=hello@voiceact.tech

# ---------- Rate Limiting ----------
RATE_LIMIT_GENERAL=60
RATE_LIMIT_CONTACT=10
RATE_LIMIT_AUTH=5

# ---------- PostHog Analytics ----------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_KEY=

# ---------- Sentry Error Tracking ----------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=voice-act-solution
SENTRY_PROJECT=javascript-nextjs

# ---------- Next.js ----------
# When behind Nginx, the frontend calls the API via the internal Docker network
NEXT_PUBLIC_API_URL=http://localhost/api

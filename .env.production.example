# ===================================================
# VoiceAct Production Environment (.env on VPS)
# Place this file as `.env` on your VPS in your project directory
# ===================================================

# ---------- Docker Hub Credentials ----------
DOCKERHUB_USERNAME=adityakbr
DOCKERHUB_TOKEN=your_dockerhub_pat_token_here

# ---------- Database (MongoDB Atlas / External Cluster) ----------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/voiceact?retryWrites=true&w=majority

# ---------- JWT ----------
JWT_SECRET=generate_a_secure_32_plus_character_random_secret_key_here
JWT_EXPIRES_IN=7d

# ---------- Domain & Security ----------
CORS_ORIGINS=https://voiceact.tech,https://www.voiceact.tech
COOKIE_DOMAIN=.voiceact.tech
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ---------- Next.js Public API URL ----------
NEXT_PUBLIC_API_URL=https://voiceact.tech/api

# ---------- Host Port Configuration (For Host Nginx Reverse Proxy) ----------
# Change these if you run multiple projects on the same VPS to avoid conflicts.
HOST_WEB_PORT=3001
HOST_API_PORT=5001

# ---------- SMTP Email Settings (optional) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="VoiceAct Support <noreply@voiceact.tech>"
ADMIN_NOTIFY_EMAIL=admin@voiceact.tech

# ---------- Rate Limiting ----------
RATE_LIMIT_GENERAL=60
RATE_LIMIT_CONTACT=10
RATE_LIMIT_AUTH=5

# ---------- PostHog Analytics (optional) ----------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_KEY=

# ---------- Sentry Error Tracking (optional) ----------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=voice-act-solution
SENTRY_PROJECT=javascript-nextjs
